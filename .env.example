# Client id of the Hubly OAuth app (public app — no secret).
# Create at https://huggingface.co/settings/applications/new
# Scopes: openid, profile, write-discussions, write-collections
EXPO_PUBLIC_HF_CLIENT_ID=

# Optional: override the Hub API host (mirror or self-hosted reverse proxy).
# Defaults to https://huggingface.co
EXPO_PUBLIC_HF_ENDPOINT=
