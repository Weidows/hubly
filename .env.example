# Hubly's OAuth app is a public client (no secret), so this id is not sensitive — it ships inside
# the app binary anyway. It is committed so a fresh clone can sign in.
# Create/manage at https://huggingface.co/settings/applications/new
# Scopes: openid, profile, write-discussions, write-collections · Redirect URI: none (device flow)
EXPO_PUBLIC_HF_CLIENT_ID=ac1be4f0-de96-4d2a-83e2-705325beda27

# Optional: override the Hub API host (mirror or self-hosted reverse proxy).
# Defaults to https://huggingface.co
EXPO_PUBLIC_HF_ENDPOINT=
